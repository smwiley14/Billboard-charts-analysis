[Unit]
Description=Billboard Charts Analysis Dashboard (Streamlit)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/billboard-dashboard
Environment="PATH=/opt/billboard-dashboard/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/opt/billboard-dashboard/.env
ExecStart=/opt/billboard-dashboard/venv/bin/streamlit run dashboard.py --server.port 8501 --server.address 0.0.0.0 --server.headless true
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

